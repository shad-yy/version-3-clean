    "implementation_guidance": {
      "common_reasons_for_404s_on_site": [
        "Using wrong endpoint name or misspelling (e.g. 'livescore.php' does not exist).",
        "Not including API key in the URL path or using invalid/empty API key — confirm env var THESPORTSDB_API_KEY or use '1'.",
        "Incorrect parameter names or using numeric IDs where string/encoded names are required (or vice versa).",
        "Season formatting errors (must be 'YYYY-YYYY').",
        "Calling premium-only endpoints beyond free-limit that yield empty results for free key."
      ],
      "recommended_client_behaviour": [
        "Always build URL via base_url_template + encodeURIComponent(params).",
        "Implement centralized request wrapper that: (1) injects API key into path, (2) logs full request URL + query params, (3) retries 1 time on network errors, (4) maps 404 or unexpected response bodies to structured errors with endpoint, params, serverStatus, and rawResponse for debugging.",
        "Rate-limit locally (leaky-bucket) to 30 req/min by default; increase when premium key present.",
        "Cache GET responses aggressively: per-endpoint TTL suggestions — lists (all_sports, all_countries, all_leagues): 24h; league/team/player lookups: 30m; eventsday/eventsseason/eventsnext/eventslast/eventsnextleague/eventspastleague: 60s; event/lineup/stats/tv: 30s.",
        "Validate inputs before calling (IDs numeric, season format correct, dates iso 'YYYY-MM-DD').",
        "If an endpoint returns 404 with a valid request, capture raw response and save one sample (URL + response) for debugging; do not fall back to mock silently — surface to logs and admin UI."
      ],
