      "notes": "This JSON is a complete, implementation-focused representation of TheSportsDB v1 endpoints, parameters, limits, examples and recommended usage patterns as extracted from the provided documentation. Use this as the canonical API spec to (1) drive client code generation, (2) validate endpoints called by the site, and (3) create automated tests that verify each endpoint returns concrete data rather than 404/empty responses."
    },
    "base": {
      "base_url_template": "https://www.thesportsdb.com/api/v1/json/{API_KEY}/",
      "free_key_default": "123",
      "auth": {
        "method": "url_path",
        "pattern": "/api/v1/json/{API_KEY}/",
        "notes": "If THESPORTSDB_API_KEY is not set, use '123' for free-tier access. Some endpoints limit returned data for free key and may only return home events or limited records."
      },
      "rate_limits": {
        "free": { "requests_per_minute": 30, "behavior_on_limit": "HTTP 429 - wait 1 minute" },
        "premium": { "requests_per_minute": 100 },
        "business": { "requests_per_minute": 120 }
      },
      "global_notes": [
        "All endpoints are GET unless explicitly stated.",
        "URL parameters must be URL-encoded (spaces -> underscores or %20 depending on server side usage in examples underscores used).",
        "Season format when required: 'YYYY-YYYY' (e.g. '2020-2021').",
        "Free tier sometimes returns only partial results (eg. next events only home events).",
        "No 'livescore.php' endpoint in v1 — do not call it. Use eventsday.php, eventsnext.php, eventslast.php, eventsseason.php and eventsnextleague/eventspastleague to retrieve recent/next/past events."
      ]
    },
